# Change this value outside local development.
CAIRNOPS_POSTGRES_PASSWORD=replace-me

# Required temporary secret for the protected bootstrap API (32+ characters).
# Generate one with: openssl rand -base64 32
CAIRNOPS_BOOTSTRAP_TOKEN=

# Public HTTP port exposed by Docker Compose.
CAIRNOPS_HTTP_PORT=8080

# Canonical browser origin. HTTPS is mandatory outside localhost.
CAIRNOPS_PUBLIC_URL=http://localhost:8080

# Optional outside Compose. The server creates this 0600 file once and uses it
# to seal Connector credentials. Back it up separately with PostgreSQL.
# CAIRNOPS_MASTER_KEY_FILE=/var/lib/cairnops/master.key

# Optional stable identifier for a single manually launched worker.
# Compose leaves it unset so every worker derives a unique container hostname.
# CAIRNOPS_INSTANCE_ID=cairnops-worker-01

# Optional official Push Relay endpoint. HTTPS is mandatory. Without it,
# mobile identities keep working but the Push component is reported unavailable.
# CAIRNOPS_PUSH_RELAY_URL=https://push.cairnops.example
